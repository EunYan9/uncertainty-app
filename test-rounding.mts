// 用引擎的 finalizeResult 复现 PPT 幻灯片（N̄=1.234mm）的修约/对齐规则，供逐条验证
import { finalizeResult } from './src/lib/uncertainty.ts'

let fail = 0
function check(U: number, meanAligned: number, place: number, expU: string, expM: string, note: string) {
  const f = finalizeResult(U, meanAligned, place)
  const ok = f.UDisplay === expU && f.finalMeanDisplay === expM
  if (!ok) fail++
  console.log(`${ok ? '✓' : '✗'} U原始=${String(U).padEnd(11)} → (${f.finalMeanDisplay} ± ${f.UDisplay})  【${note}】`)
}

console.log('—— 均值 1.234 mm（测量精度 10⁻³），对照 PPT 三种情形 ——')
check(0.007,  1.234, -3, '0.007',  '1.234',  '情形1：U=0.00α（同位，1位）')
check(0.0023, 1.234, -3, '0.0023', '1.2340', '情形1变体：同位但 α≤2 → U留2位，均值补零')
check(0.0004, 1.234, -3, '0.0004', '1.2340', '情形2：U=0.000α，α≤5 → 均值补零')
check(0.0005, 1.234, -3, '0.0005', '1.2340', '情形2边界：α=5（凑偶）→ 仍补零')
check(0.0006, 1.234, -3, '0.001',  '1.234',  '情形2：α≥6 → 向上修约')
check(0.0009, 1.234, -3, '0.001',  '1.234',  '情形2：α=9 → 向上修约')
check(0.014,  1.234, -3, '0.014',  '1.234',  '情形3：U=0.0αβ，α≤2 → U留2位')
check(0.047,  1.234, -3, '0.05',   '1.23',   '情形3：3≤α≤9 → U留1位，均值修约')
check(0.043,  1.234, -3, '0.04',   '1.23',   '情形3：α=4,β=3')
check(0.12,   1.234, -3, '0.12',   '1.23',   '情形3：更粗且 α≤2 → U=0.12，均值修约到百分位')
check(0.8,    1.234, -3, '0.8',    '1.2',    '情形3：U=0.8 → 均值修约到十分位')

console.log('\n—— 均值 63.564 → 对齐 63.56 cm（测量精度 10⁻²），含绪论P47例题 ——')
check(0.048703411, 63.56, -2, '0.05',   '63.56',   '绪论P47例题：α=4 → (63.56±0.05)，教材答案')
check(0.003,  63.56, -2, '0.003',  '63.560',  'U 比均值细一级、α≤5 → 均值补零')
check(0.0003, 63.56, -2, '0.0003', '63.5600', 'U 细两级 → U留自身位，均值补零对齐')
check(0.0007, 63.56, -2, '0.0007', '63.5600', 'U 细两级（修约到均值位必为0）→ 均值补零对齐')
check(0.012,  63.56, -2, '0.012',  '63.560',  '同位但 α≤2 → U留2位，均值补零（本次修复的情形）')
check(0.11,   63.56, -2, '0.11',   '63.56',   '更粗且 α≤2 → U=0.11，均值不变')

if (fail) { console.error(`\n${fail} 个用例失败`); process.exit(1) }
console.log('\n全部用例通过')
